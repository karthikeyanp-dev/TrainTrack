# Use the SAME Firebase project as TrainTrack. Public configuration only.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south1
# Register this separate website in Firebase App Check (reCAPTCHA Enterprise).
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Explicit local-only demo mode; never submits or shows a real receipt.
NEXT_PUBLIC_CUSTOMER_FORM_PREVIEW=false
# Local integration only: demo-* project on localhost; ignored in production.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
